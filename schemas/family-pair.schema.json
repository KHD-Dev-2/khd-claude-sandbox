{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHD canonical family pair",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","family_id","domain","signature","surface_id","depth","seed","question","trace","answer","generator"],
  "properties": {
    "id": {"type":"string","pattern":"^F[0-9]{3}-[0-9]{6}$"},
    "family_id": {"type":"string","pattern":"^F[0-9]{3}$"},
    "domain": {"enum":["biologie","chimie","informatique","epidemiologie","mathematiques","physique"]},
    "signature": {"type":"string","minLength":5},
    "surface_id": {"type":"string","pattern":"^F[0-9]{3}-S[0-9]+$"},
    "depth": {"type":"integer","minimum":1,"maximum":4},
    "seed": {"type":"integer"},
    "question": {"type":"string","minLength":5},
    "trace": {
      "type":"array","minItems":1,"maxItems":4,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["op","args","res"],
        "properties": {
          "op":{"enum":["add","sub","mul","div","mean","percent","log10","neg","pow"]},
          "args":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"number"}},
          "res":{"type":"number"}
        }
      }
    },
    "answer": {
      "type":"object","additionalProperties":false,
      "required":["value","unit","tol"],
      "properties": {"value":{"type":"number"},"unit":{"type":"string"},"tol":{"type":"string","pattern":"^(rel|abs):[0-9.]+$"}}
    },
    "generator": {"type":"string","pattern":"^gen-v[0-9]+@[a-f0-9]{8,64}$"}
  }
}
